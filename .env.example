# Copy the variables you need into the .env of the Laravel application
# that installs this package. The package itself reads them via config/siwx.php.

# Required. Comma separated allow list. An empty value rejects every
# verification with siwx_invalid_domain — that is intentional.
SIWX_ALLOWED_DOMAINS=dapp.example

# Nonce lifetime in seconds.
SIWX_NONCE_TTL=600

# Tolerance in seconds for a wallet clock running ahead of the server.
SIWX_CLOCK_SKEW=300

# Cache store used for nonces. Empty means the application default.
SIWX_CACHE_STORE=

# Built-in GET /siwx/nonce route.
SIWX_ROUTES_ENABLED=true
SIWX_ROUTES_PREFIX=siwx

# Smart contract wallets (EIP-1271). Off by default; the only network call
# in the package.
SIWX_EIP1271_ENABLED=false
SIWX_RPC_URL=
